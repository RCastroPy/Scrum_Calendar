# Database credentials used by docker-compose DB service
DB_USER=scrum_user
DB_PASSWORD=scrum_pass
DB_NAME=scrum_calendar

# API connection string (inside docker network, host is `db`)
DATABASE_URL=postgresql+psycopg2://scrum_user:scrum_pass@db:5432/scrum_calendar
APP_ENV=development
APP_TIMEZONE=America/Asuncion
CORS_ORIGINS_RAW=http://localhost:8000
CORS_ALLOW_CREDENTIALS=false
PBKDF2_ROUNDS=600000
# Local uses HTTP; production forces Secure automatically and should use HTTPS.
SESSION_COOKIE_SECURE=false
CSRF_PROTECTION_ENABLED=false
DISABLE_DOCS_IN_PRODUCTION=true
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
SECURITY_AUDIT_LOG_ENABLED=true
